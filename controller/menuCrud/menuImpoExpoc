// ========== MENUS ==========
int viewMenuImportacaoExportacao(void) {
    int opcao;
    
    limparTela();
    exibirCabecalhoExportacao();
    
    printf("\n┌─────────────────────────────────────┐\n");
    printf("│  IMPORTAÇÃO E EXPORTAÇÃO DE DADOS   │\n");
    printf("├─────────────────────────────────────┤\n");
    printf("│ 1. Exportar Dados                   │\n");
    printf("│ 2. Importar Dados                   │\n");
    printf("│ 0. Voltar ao Menu Principal         │\n");
    printf("└─────────────────────────────────────┘\n");
    printf("\nEscolha uma opção: ");
    
    scanf("%d", &opcao);
    getchar();
    
    return opcao;
}

// ========== SOLICITAÇÕES DE ENTRADA ==========
void viewSolicitarNomeArquivo(char* nomeArquivo, const char* titulo) {
    printf("\n%s\n", titulo);
    printf("Digite o nome do arquivo (sem extensão): ");
    fgets(nomeArquivo, 256, stdin);
    
    // Remove quebra de linha
    size_t len = strlen(nomeArquivo);
    if (len > 0 && nomeArquivo[len-1] == '\n') {
        nomeArquivo[len-1] = '\0';
    }
}

// ========== EXIBIÇÃO DE RESULTADOS ==========
void viewExibirSucessoExportacao(int quantidade, const char* nomeArquivo, const char* tipo) {
    printf("\n✓ EXPORTAÇÃO REALIZADA COM SUCESSO!\n");
    printf("  Tipo: %s\n", tipo);
    printf("  Quantidade: %d registros\n", quantidade);
    printf("  Arquivo: %s.csv\n", nomeArquivo);
}

void viewExibirResultadoImportacao(int resultado, int quantidade, const char* tipo) {
    if (resultado == 1) {
        printf("\n✓ IMPORTAÇÃO REALIZADA COM SUCESSO!\n");
        printf("  Tipo: %s\n", tipo);
        printf("  Quantidade: %d registros importados\n", quantidade);
    } else {
        printf("\n✗ Erro na importação do arquivo!\n");
    }
}

